            </geometry>
        </collision>
    </link>

    <!-- frame_to_leftbackwheel -->
    <joint name="leftbackwheel_joint" type="continuous">
        <origin xyz="-0.276 -0.317 -0.194" rpy="0.0 0.0 0.0"/>
        <parent link="frame_link"/>
        <child link="leftbackwheel_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters) -->
        <axis xyz="1 0 0"/>
        <!-- <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="leftbackwheel_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
