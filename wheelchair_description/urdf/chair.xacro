            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/visual/right_handle_visual.stl"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/collision/right_handle_collision.stl"/>
            </geometry>
        </collision>
    </link>

    <!-- frame to left_pin -->
    <joint name="left_pin_joint" type="fixed">
        <origin xyz="-0.003 0.027 -0.081" rpy="0.0 0.0 0.0"/>
        <parent link="left_caster_link"/>
        <child link="left_pin_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters) -->
        <!-- <axis xyz="0 0 0"/>
        <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
    </joint>

    <link name="left_pin_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/visual/left_pin_visual.obj"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/collision/left_pin_collision.stl"/>
            </geometry>
        </collision>
    </link>

    <!-- frame to right_pin -->
    <joint name="right_pin_joint" type="fixed">
        <origin xyz="0.003 0.027 -0.081" rpy="0.0 0.0 0.0"/>
        <parent link="right_caster_link"/>
        <child link="right_pin_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters) -->
        <!-- <axis xyz="0 0 0"/>
        <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
    </joint>

    <link name="right_pin_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/visual/right_pin_visual.obj"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/collision/right_pin_collision.stl"/>
            </geometry>
        </collision>
    </link>

<!-- blue=up/down(z); green=front/back(y); red=left/right(x);  -->
    <!-- for ros2_control -->
    <ros2_control name="RobotSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      
      <joint name="leftbackwheel_joint">
        <command_interface name="velocity">
          <param name="min">-4.5</param>
          <param name="max">4.5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <joint name="rightbackwheel_joint">
        <command_interface name="velocity">
          <param name="min">-4.5</param>
          <param name="max">4.5</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find wheelchair_controller)/config/wheelchair_controllers.yaml</parameters>
      </plugin>
      <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>
</robot>