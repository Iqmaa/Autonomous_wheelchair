<?xml version="1.0"?>
<robot name="wheelchair" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- base: to get robot position and details relative to the world-->
    <link name="world_root"/>

    <link name="base_footprint">
     <inertial>
       <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
       <mass value="0.001"/> 
       <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
     </inertial>
    </link>

    <!-- added this when i was getting kdl errors, why? -->
    <joint name="world_root_to_footprint_joint" type="fixed">
        <parent link="world_root"/>
        <child link="base_footprint"/>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </joint>

    <!-- base_footprint to base_link -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="base_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="15.0"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/visual/base_link_visual.obj"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/collision/base_link_collision.stl"/>
            </geometry>
        </collision>
    </link>

    <!-- The actual Wheelchair -->

    <!-- base to frame joint -->
    <joint name="frame_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="frame_link"/>
    </joint>

    <link name="frame_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/visual/frame_visual.obj"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/collision/frame_collision.stl"/>
            </geometry>
        </collision>
    </link>

    <!-- frame_to_seat -->
    <joint name="seat_joint" type="fixed">
        <origin xyz="0.0 -0.070 -0.038" rpy="0.0 0.0 0.0"/>
        <parent link="frame_link"/>
        <child link="seat_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters) -->
        <!-- <axis xyz="0 0 1"/>
        <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
    </joint>

    <link name="seat_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/visual/seat_visual.obj"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/collision/seat_collision.stl"/>
            </geometry>
        </collision>
    </link>

    <!-- frame_to_back -->
    <joint name="back_joint" type="fixed">
        <origin xyz="0.0 -0.315 0.168" rpy="0.0 0.0 0.0"/>
        <parent link="frame_link"/>
        <child link="back_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters) -->
        <!-- <axis xyz="0 0 1"/>
        <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
    </joint>

    <link name="back_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/visual/back_visual.obj"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://wheelchair_description/meshes/collision/back_collision.stl"/>
            </geometry>
        </collision>
    </link>
    
    <!-- frame_to_left-panel -->
    <joint name="left_panel_joint" type="fixed">
        <origin xyz="-0.238 -0.100 0.044" rpy="0.0 0.0 0.0"/>
        <parent link="frame_link"/>
        <child link="left_panel_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters) -->
        <!-- <axis xyz="0 1 0"/>
        <limit lower="-1.0" upper="1.0" effort="10.0" velocity="1.0"/> -->
    </joint>

    <link name="left_panel_link">
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
