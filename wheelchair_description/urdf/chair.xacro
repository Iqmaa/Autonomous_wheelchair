    </link>
    
    <!-- frame_to_right-panel -->
    <joint name="right_panel_joint" type="fixed">
        <origin xyz="0.238 -0.100 0.043" rpy="0.0 0.0 0.0"/>
        <parent link="frame_link"/>
        <child link="right_panel_link"/>
        <!-- prismatic adds: Prevents math crashes by setting motion bounds (in meters) -->
        <!-- <axis xyz="0 0 1"/>
